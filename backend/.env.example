PORT=3000
NODE_ENV=development

# URL frontend (CORS + link di notifikasi WhatsApp)
FRONTEND_URL=http://localhost:5173
# URL publik yang dicetak di stiker QR: {APP_URL}/s/{kode}
APP_URL=http://localhost:5173

# Di belakang reverse proxy (Vercel -> Render = 2 hop). Kosongkan di dev.
# TRUST_PROXY=2

# Wajib diganti di production (minimal 32 karakter acak)
JWT_SECRET=ganti_dengan_string_acak_minimal_32_karakter

# Development: SQLite
DATABASE_URL="file:./dev.db"
# Production (Neon PostgreSQL):
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Gateway WhatsApp (Fonnte). Kosongkan = MODE DEV (notifikasi dicetak ke console server)
WHATSAPP_API_TOKEN=""
WHATSAPP_API_URL="https://api.fonnte.com/send"

# Cloudflare Turnstile untuk form komentar (opsional, kosong = nonaktif)
TURNSTILE_SECRET=""
