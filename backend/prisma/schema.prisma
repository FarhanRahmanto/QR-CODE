// Development memakai SQLite. Saat build production (Render/Docker),
// scripts/prepare-prod-schema.mjs otomatis mengganti provider menjadi "postgresql".
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique // login: email + kata sandi
  password  String
  phone     String   @unique // wajib: dihubungi penemu via WhatsApp & notifikasi scan
  items     Item[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Item {
  id             String    @id @default(cuid())
  publicCode     String    @unique
  ownerId        String
  owner          User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerName      String
  itemName       String
  photoUrl       String?   // "/api/photos/{id}" atau URL eksternal
  description    String
  ownerMessage   String?
  status         String    @default("SAFE") // "SAFE" | "LOST"
  allowWhatsapp  Boolean   @default(false)
  allowComments  Boolean   @default(true) // PRD P5: form laporan bisa dinonaktifkan
  lastNotifiedAt DateTime?
  comments       Comment[]
  scans          Scan[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([ownerId])
}

model Comment {
  id         String   @id @default(cuid())
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  finderName String?
  message    String
  location   String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([itemId])
}

model Scan {
  id        String   @id @default(cuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  ipHash    String?
  userAgent String?
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())

  @@index([itemId])
}

// Foto barang (WebP terkompresi) disimpan di database agar tidak hilang
// di hosting tanpa disk permanen (mis. Render Free).
model Photo {
  id        String   @id @default(cuid())
  data      Bytes
  mimeType  String   @default("image/webp")
  createdAt DateTime @default(now())
}
